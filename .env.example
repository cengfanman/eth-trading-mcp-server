# Ethereum RPC endpoint (required)
# Get a free API key from:
# - Infura: https://infura.io/
# - Alchemy: https://www.alchemy.com/
# - Or use a public endpoint (may be rate-limited)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Private key with 0x prefix (required)
# ⚠️ WARNING: This is used ONLY for transaction construction/simulation
# NO transactions are ever broadcast to the network
# Never commit this file with a real private key!
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Chain ID (optional, defaults to 1 for Ethereum mainnet)
CHAIN_ID=1

# Log level (optional, defaults to info)
# Options: trace, debug, info, warn, error
RUST_LOG=info
